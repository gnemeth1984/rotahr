// ── HR: Onboarding Tasks ──────────────────────────────────────────────────────
model OnboardingTask {
  id         String   @id @default(cuid())
  businessId String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
