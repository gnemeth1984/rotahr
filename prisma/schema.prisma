// Named equipment units per business — fridges, freezers, hot-holding stations
model HACCPEquipment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String // "Main Fridge", "Bar Fridge 1", "Walk-in"
  equipType  String // fridge | freezer | hot_holding | cooking | cooling
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, equipType])
}

// Custom reminder schedule per business per check type — fully configurable
model HACCPSchedule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  checkType  String
  times      Json // string[] "HH:mm" in 24h format, e.g. ["08:00","14:00","20:00"]
  daysOfWeek Json // int[] 0=Sun..6=Sat, empty array = every day
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

