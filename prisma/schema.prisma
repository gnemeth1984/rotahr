// Internal tool: Blog Comment Assistant (Gabor-only, not tenant-scoped)
model BlogCommentArticle {
  id              String   @id @default(cuid())
  title           String
  url             String
  snippet         String?
  topic           String?
  region          String?
  source          String   @default("user") // "seed" | "user" | "auto"
  hasComments     Boolean?
  commentPlatform String?
  used            Boolean  @default(false) // true once a comment has been drafted for this article
  createdAt       DateTime @default(now())
}

// Maintained list of competitor/other-service names the daily discovery cron
// searches for — editable so Gabor can add/remove without a code change.
model Competitor {
  id              String    @id @default(cuid())
  name            String    @unique
  category        String? // e.g. "scheduling", "HR", "POS", "food costing", "menu"
  searchQualifier String? // extra disambiguating phrase for generic names, e.g. "Sling" -> "employee scheduling app"
  active          Boolean   @default(true)
  lastCheckedAt   DateTime?
  createdAt       DateTime  @default(now())
}

model BlogCommentDraft {
  id           String   @id @default(cuid())
  articleId    String?
  articleTitle String
  articleUrl   String
  note         String?
  draftComment String   @db.Text
  createdAt    DateTime @default(now())
}

// ── Manager Log Book ─────────────────────────────────────────────────────────
// Daily shift notes, 86'd items, and maintenance/repair issues — separate from
// HACCP (food-safety specific). Matches the "manager log book" pattern.
model LogEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  venueId    String?
  venue      Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  type        String // "note" | "86" | "repair"
  title       String
  description String?   @db.Text
  resolved    Boolean   @default(false) // relevant for "86" (back in stock) and "repair" (fixed)
  resolvedAt  DateTime?

  // Repair/maintenance scheduling — who's fixing it and when they're due
  assignedToName String? // free text, e.g. "Ben" or "ACME Refrigeration" — not necessarily a Rotahr user
  dueAt          DateTime? // when the repair person/contractor is expected

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  updates LogEntryUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, type, resolved])
  @@index([businessId, createdAt])
  @@index([businessId, dueAt])
}

// Running notes thread on a log entry — e.g. "Called Ben, due Tuesday 2pm",
// "Ben rescheduled to Wednesday", "Fixed, tested working" — managers post updates
// so everyone can see the latest status without re-asking.
model LogEntryUpdate {
  id          String   @id @default(cuid())
  logEntryId  String
  logEntry    LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  note        String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([logEntryId])
}

// ── Ops Task Management ──────────────────────────────────────────────────────
// General daily/weekly/one-time operational tasks (not food-safety — see HACCP
// for that). Assignable to an employee, with optional photo proof of completion.
model OpsTask {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  venueId    String?
  venue      Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  title        String
  description  String?   @db.Text
  frequency    String    @default("once") // "once" | "daily" | "weekly"
  dueDate      DateTime?
  requirePhoto Boolean   @default(false)

  assignedToId String?
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // Auto-assign mode: instead of (or in addition to) one fixed person, a task
  // can target a role and/or department — visible/notifiable to whoever is
  // actually clocked in or on today's published shift matching it, so a
  // recurring task never sits orphaned just because the named person is off.
  assignedRole         String?
  assignedDepartmentId String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)

  // Set when this task was created directly from a message ("convert to task")
  sourceMessageId String?

  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  photoUrl      String? // Vercel Blob URL, present if requirePhoto and completed

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  updates OpsTaskUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, completed, dueDate])
  @@index([businessId, frequency])
  @@index([assignedToId])
  @@index([assignedDepartmentId])
}

// Comment/activity thread on a task — same pattern as LogEntryUpdate, so a
// task is a running conversation ("tried calling the supplier, no answer")
// instead of a bare checkbox with no context.
model OpsTaskUpdate {
  id          String   @id @default(cuid())
  opsTaskId   String
  opsTask     OpsTask  @relation(fields: [opsTaskId], references: [id], onDelete: Cascade)
  note        String   @db.Text
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([opsTaskId])
}

// ── Persistent department channels (replace one-off group broadcasts) ──────
// Membership is derived from Employee.departmentId (or "everyone" when
// departmentId is null) — no separate membership table to keep in sync when
// staff join/leave a department.
model MessageChannel {
  id           String      @id @default(cuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  departmentId String?     @unique
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String // "Everyone" for the businesswide channel, else the department name

  messages  ChannelMessage[]
  createdAt DateTime         @default(now())

  @@index([businessId])
}

model ChannelMessage {
  id        String         @id @default(cuid())
  channelId String
  channel   MessageChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId  String
  sender    Employee       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String         @db.Text
  urgent    Boolean        @default(false) // urgent messages require explicit acknowledgement, not just "seen on open"

  receipts  ChannelMessageReceipt[]
  createdAt DateTime                @default(now())

  @@index([channelId, createdAt])
}

// Read/acknowledge receipts — normal messages get one automatically when a
// member opens the channel; urgent messages only get one via an explicit
// "Acknowledge" tap, so a manager can see who has and hasn't actually seen it.
model ChannelMessageReceipt {
  id               String         @id @default(cuid())
  channelMessageId String
  channelMessage   ChannelMessage @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt           DateTime       @default(now())

  @@unique([channelMessageId, employeeId])
  @@index([employeeId])
}

// ── Connected Email (send-as-yourself via Gmail/Outlook) ─────────────────────
// One connection per business — CRM emails send through the connected inbox
// instead of the shared sales@rotahr.com address when present.
model EmailConnection {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  provider String // "gmail" (more providers can be added later)
  email    String // the connected inbox address, e.g. manager@theirbar.com

  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime // access token expiry — refreshed automatically when sending

  connectedById String
  connectedBy   User   @relation(fields: [connectedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

// ── CRM Promotional Offers ────────────────────────────────────────────────────
// Quick, ready-made offer codes managers can generate per customer (birthday
// drink, win-back discount, VIP thank-you, welcome offer, or a custom one) and
// drop straight into a CRM email.
model PromoOffer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  code        String @unique // e.g. "SARAH-BDAY-7F3K"
  offerType   String // "birthday" | "winback" | "vip" | "welcome" | "custom"
  title       String // e.g. "Happy Birthday!"
  description String // e.g. "Enjoy a free drink on us during your birthday month"

  expiresAt  DateTime?
  redeemed   Boolean   @default(false)
  redeemedAt DateTime?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, redeemed])
  @@index([customerId])
}

/// Marketing email opt-outs.
/// Kept in the main app database on purpose: the unsubscribe link has to keep
/// working even when the outreach service is down, and an opt-out we lose is a
/// GDPR problem. The outreach service is told best-effort and is not trusted
/// as the source of truth.
model EmailSuppression {
  id        String    @id @default(cuid())
  email     String    @unique
  source    String    @default("unsubscribe_link") // unsubscribe_link | complaint | manual | bounce
  reason    String?
  userAgent String?
  createdAt DateTime  @default(now())
  /// Set when someone undoes an opt-out (e.g. a mail scanner prefetched the link).
  revokedAt DateTime?

  @@index([email])
}

/// Single-row lock + status for the demo data reset.
///
/// The reset is destructive and takes ~2 minutes, so both the cooldown and the
/// "setting up your demo" interstitial need to agree on whether one is running.
/// In-memory state can't do that: on Vercel each request may hit a different
/// instance, and even in dev Next bundles the auth callback and the status route
/// separately. So the state lives in the database.
model DemoResetState {
  id         String    @id
  running    Boolean   @default(false)
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

/// A stored site audit run, for any domain.
///
/// Domain-agnostic on purpose: the same engine audits rotahr.com and any
/// prospect's site, so this table is keyed by hostname rather than businessId.
/// The full report is kept as JSON because the shape is presentational and
/// evolves with the auditor; the extracted columns exist only so the history
/// list can be sorted and filtered without parsing every blob.
model SiteAudit {
  id     String @id @default(cuid())
  domain String
  origin String

  score         Int
  pagesCrawled  Int
  issueCount    Int
  criticalCount Int
  warningCount  Int

  /// Lighthouse performance score, null when PSI was skipped or rate limited.
  performance Int?
  lcp         Float?
  cls         Float?

  /// Full AuditReport, including every page and issue.
  report Json

  durationMs Int
  /// Platform admin who triggered the run.
  runById    String?

  createdAt DateTime @default(now())

  @@index([domain, createdAt])
  @@index([createdAt])
}

/// Cold-outreach lead. Replaces the SQLite table in the standalone Railway
/// sender, which died with its volume and took the send history with it.
/// Lives in Neon so the lead list, the suppression list and the app share one
/// database and one source of truth.
model OutreachLead {
  id      String @id @default(cuid())
  email   String @unique
  name    String
  segment String @default("Restaurant")
  city    String @default("")
  region  String @default("")
  /// ISO-ish market code: ie | uk | us | ca | au. Drives currency, tax wording
  /// and which site URL the email links to.
  country String @default("ie")

  /// Sequence position AND lifecycle state: new -> contacted -> followup_1 ->
  /// followup_2 -> followup_3 -> cold. Terminal: replied | unsubscribed | bounced.
  status        String    @default("new")
  contactCount  Int       @default(0)
  lastContacted DateTime?

  /// Set when a send hard-bounces, so the address is never retried.
  bouncedAt DateTime?
  /// Set manually when someone replies — stops the sequence immediately.
  repliedAt DateTime?

  /// Result of the SMTP mailbox probe: ok | dead | catch-all | no-mx | unknown.
  /// Scraped lists are full of invented `info@` addresses on real domains, which
  /// is why an MX check cleared all 9 of August's hard bounces. `dead` and
  /// `no-mx` block sending; `unknown` never does.
  emailVerdict String?
  /// Raw SMTP reply behind the verdict, kept so a wrong call can be argued with.
  verifyDetail String?
  /// When the probe last ran. Mailboxes come and go, so an old verdict is a
  /// stale one and gets re-checked rather than trusted forever.
  verifiedAt   DateTime?

  notes  String? @db.Text
  source String? // which CSV / research run it came from

  sends OutreachSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, lastContacted])
  @@index([country, status])
  @@index([segment])
  @@index([emailVerdict])
}

/// One row per email actually handed to Brevo. `messageId` is what the Brevo
/// webhook matches on to record opens and clicks.
model OutreachSend {
  id     String       @id @default(cuid())
  leadId String
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  email   String
  segment String @default("")
  /// Which sequence step this send was — the lead's status at send time.
  step    String
  subject String

  messageId String? @unique

  opened       Boolean   @default(false)
  clicked      Boolean   @default(false)
  openedAt     DateTime?
  clickedAt    DateTime?
  /// Populated from the Brevo webhook on hard_bounce / blocked / spam.
  failedAt     DateTime?
  failedReason String?

  sentAt DateTime @default(now())

  @@index([leadId, sentAt])
  @@index([sentAt])
  @@index([step])
}

/// Per-day send counter, so the daily cap survives serverless cold starts.
/// A single row per calendar day keyed by YYYY-MM-DD in Europe/Dublin.
model OutreachDailyCount {
  date  String @id
  count Int    @default(0)
}

/// One row per address that has been sent the signup welcome email.
/// Exists purely to make the send idempotent: a user who registers and then
/// completes onboarding triggers it twice, and both paths are fire-and-forget
/// so neither can tell the other has already run.
model WelcomeEmailLog {
  id     String   @id @default(cuid())
  email  String   @unique
  sentAt DateTime @default(now())

  @@index([sentAt])
}

// ─── AI inbox assistant (sales@rotahr.com) ───────────────────────────────────

/// One row per inbound message pulled from the sales@ mailbox over IMAP.
///
/// The mailbox stays the source of truth for the mail itself — this table
/// exists so a message can be classified, drafted for, triaged and audited
/// without re-reading IMAP on every page load, and so a reply is provably
/// sent at most once.
///
/// `imapUid` + `mailbox` is the idempotency key. IMAP UIDs are only unique
/// within a mailbox, and a sync that overlaps a previous run (a retry, a cron
/// double-fire) must not create a second row and a second draft for a message
/// that already has one.
model InboundEmail {
  id      String @id @default(cuid())
  imapUid Int
  mailbox String @default("INBOX")

  messageId  String? // RFC 5322 Message-ID, used to thread the reply
  inReplyTo  String?
  references String? @db.Text

  fromEmail  String
  fromName   String?
  toEmail    String?
  subject    String   @db.Text
  bodyText   String   @db.Text
  receivedAt DateTime

  /// Set when the message is a bounce, auto-reply or other machine mail.
  /// Replying to these creates mail loops and burns sender reputation, so they
  /// are never drafted for and never auto-sent.
  isAutomated Boolean @default(false)

  // ── Classification (written by the AI pass) ──
  category   String? // sales | outreach-reply | partner | support | billing | press | spam | other
  intent     String? @db.Text
  sentiment  String? // positive | neutral | negative
  confidence Float? // 0..1 as reported by the model
  language   String?

  /// True when the message touches something the AI must never answer alone
  /// (custom pricing, legal/GDPR, refunds, asking for a human, low confidence).
  needsHuman       Boolean @default(false)
  escalationReason String?

  // ── Draft reply ──
  draftSubject String?   @db.Text
  draftBody    String?   @db.Text
  draftModel   String?
  draftedAt    DateTime?

  /// new → drafted → sent, or archived/ignored. Terminal states are `sent`,
  /// `archived` and `ignored`; nothing re-drafts or re-sends from those.
  status String @default("new")

  sentAt        DateTime?
  sentBody      String?   @db.Text
  sentById      String?
  editedByHuman Boolean   @default(false)

  error String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mailbox, imapUid])
  @@index([status, receivedAt])
  @@index([category])
  @@index([fromEmail])
}

/// Cursor for the IMAP sync so each run only fetches what arrived since the
/// last one. Kept in the DB rather than in memory because serverless functions
/// do not survive between invocations.
model InboxSyncState {
  mailbox    String    @id
  lastUid    Int       @default(0)
  lastSyncAt DateTime?
  lastError  String?   @db.Text
  updatedAt  DateTime  @updatedAt
}

/// Append-only proof of marketing consent, for GDPR Art. 7(1) ("the controller
/// shall be able to demonstrate that the data subject has consented").
///
/// Rows are never updated or deleted, including on withdrawal — a withdrawal is
/// a new row with granted=false. The exact wording shown next to the checkbox is
/// stored per event, because consent is only valid for what the person was
/// actually told, and that wording will change over time.
model MarketingConsentEvent {
  id String @id @default(cuid())

  email      String
  businessId String?

  /// true = opted in, false = withdrawn.
  granted     Boolean
  /// Where it happened: "claim_form" | "unsubscribe_link" | "admin" | "settings".
  source      String
  /// Verbatim consent wording presented at the time.
  consentText String? @db.Text

  ip        String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([businessId])
}

/// Venues that asked us to remove the page we built for them.
///
/// The record outlives the Business row on purpose. If we only deleted the
/// business, the next bulk import from the lead list would cheerfully publish
/// the same venue again — turning one polite removal request into a repeat
/// offence. Provisioning checks this table before creating anything.
model ListingTakedown {
  id String @id @default(cuid())

  /// Normalised venue name (lowercased, punctuation stripped) — the key we can
  /// still match on after the Business row is gone.
  nameKey String  @unique
  email   String?
  slug    String?
  reason  String? @db.Text

  createdAt DateTime @default(now())

  @@index([email])
}

// LinkProspect — one place we want Rotahr mentioned, and the state of that ask.
//
// This is the only SEO gap the automated stack doesn't cover. 144 pages are
// indexable, 71 articles are published, and 5 pages have ever earned an
// impression: rotahr.com has no inbound links, so Google has no reason to rank
// it above incumbents. More content cannot fix that — 71 posts is the proof.
//
// Deliberately NOT an automated sender. Every row here is a real editor,
// association or directory whose goodwill is spent once; a cron blasting them
// would burn the list and the domain with it. The pipeline exists so nothing is
// forgotten and nothing is contacted twice, not so it can run unattended.
//
// `kind` distinguishes what the ask actually is, because they convert on
// completely different timescales:
//   directory  — free listing, we control it, days
//   press      — editor pitch, needs a story, weeks
//   guest_post — bylined article, needs writing time, weeks
//   podcast    — interview, needs a hook, weeks
//   community  — forum/association presence, ongoing
//   partner    — integration/affiliate cross-link, months
model LinkProspect {
  id     String @id @default(cuid())
  name   String
  url    String @unique
  kind   String @default("directory")
  region String @default("general") // ie | uk | general

  // Contact route, only ever what the target itself publishes. A guessed
  // editor address is a spam report against a domain we can't afford to lose.
  contactEmail String?
  contactName  String?
  contactNote  String? @db.Text // submission process, what they accept

  /// Rough authority guess, 1-10, for ordering the queue. Not a real DR score —
  /// we have no Ahrefs licence — just "how much would this matter".
  weight Int @default(5)

  /// Why this target plausibly cares about Rotahr. Written per row, because a
  /// pitch that could be sent to any of them will be ignored by all of them.
  angle String? @db.Text

  // new | queued | sent | live | rejected | no_reply
  status String @default("new")

  /// The URL of the mention once it exists — the whole point of the row.
  liveUrl String?

  sentAt     DateTime?
  liveAt     DateTime?
  followUpAt DateTime?
  notes      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, weight])
  @@index([kind])
}

/// A venue that has no website of its own, sourced from OpenStreetMap.
///
/// WHY THIS TABLE EXISTS SEPARATELY FROM `OutreachLead`
/// A lead is an email address we may pitch to. These rows frequently have no
/// email at all, and that is fine: the reason to build a page for a venue with
/// no website is that the page can rank for the venue's own name, which is how
/// `christys-the-well` reached the first page of Google in nine days. The value
/// is the ranking and the inbound claim, not an outbound send. Putting these in
/// `OutreachLead` would either pollute the sequence with un-emailable rows or
/// force us to invent addresses to fill the column.
///
/// WHY OPENSTREETMAP AND NOT GOOGLE PLACES
/// Places has better coverage and a `websiteUri` field that would answer this
/// question directly, but the Maps Platform terms forbid caching its content
/// beyond 30 days and forbid using it to build a mailing list. A permanent
/// prospect table built from Places data would breach them. OSM is ODbL: bulk
/// extraction and reuse are expressly allowed, with attribution, which the
/// public pages carry.
///
/// WHY `hasWebsite` IS STORED RATHER THAN ASSUMED
/// The absence of a `website` tag in OSM means "nobody has tagged one", not
/// "this venue has no website". Some of these will turn out to have a site we
/// simply couldn't see, and when a check finds one the row is retired rather
/// than silently rebuilt — a venue with its own homepage will outrank our page
/// for its own name, so it belongs in the ordinary pitch sequence instead.
model VenueCandidate {
  id String @id @default(cuid())

  /// OSM identity — the dedupe key. `node/123456` style, stable across re-runs,
  /// so re-sourcing the same bbox updates rows instead of duplicating them.
  osmRef String @unique

  name    String
  amenity String // pub | restaurant | cafe | bar | fast_food
  country String @default("ie")

  street      String?
  housenumber String?
  city        String?
  postcode    String?
  lat         Float?
  lon         Float?

  phone        String?
  email        String?
  facebook     String?
  instagram    String?
  openingHours String? // raw OSM opening_hours syntax, parsed at build time
  cuisine      String?

  /// Set true only once a check has actually found a live site. Null means
  /// unchecked, which is not the same as false.
  hasWebsite   Boolean?
  websiteFound String?

  // new | enriched | built | skipped | rejected
  status String @default("new")

  /// Slug of the page once one exists, so a rebuild is never a second page.
  builtSlug String?

  /// Why a row was skipped — chain, duplicate of an existing lead, no address.
  skipReason String?

  notes     String?   @db.Text
  builtAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, country])
  @@index([amenity])
  @@index([city])
}

// ---------------------------------------------------------------------------
// Navigator — private single-user daily companion (platform super-admin only).
// Deliberately NOT related to Business/Employee: this is a personal tool keyed
// on userId only, so it can never leak into or depend on tenant data.
// ---------------------------------------------------------------------------

model NavProfile {
  id     String @id @default(cuid())
  userId String @unique

  wakeTime   String  @default("07:00")
  sleepTime  String  @default("23:00")
  workStart  String  @default("09:00")
  workEnd    String  @default("18:00")
  timezone   String  @default("Europe/Dublin")
  dietary    String? @db.Text // allergies, preferences, what he actually eats
  kitchen    String? @db.Text // equipment / time available for cooking
  exercise   String? @db.Text // current activity, injuries, goals
  derailers  String? @db.Text // what usually blows the day up
  goals      String? @db.Text // what "a good week" looks like
  focusMins  Int     @default(50) // preferred hyperfocus block length
  breakMins  Int     @default(10)
  onboarded  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavDayPlan {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  energy         Int?    // 1-5 self-reported at plan time
  mood           String?
  availableHours Float?
  focusTheme     String? // the one thing that makes today a win
  blocks         Json? // [{ start, end, label, kind, taskId?, why? }]
  anchor         String? @db.Text // "if you only do one thing" line
  reflection     String? @db.Text // written at end of day
  wins           String? @db.Text
  friction       String? @db.Text
  scoreOutOf5    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model NavTask {
  id     String @id @default(cuid())
  userId String

  title    String
  notes    String? @db.Text
  project  String? // free-text project/bucket name
  parentId String? // set on micro-steps

  // todo | doing | done | parked
  status String @default("todo")
  // urgent | important | quickwin | later
  priority String @default("important")

  effortMins  Int? // honest time estimate (time-blindness compensation)
  startTrigger String? @db.Text // the exact first physical action
  dueDate     DateTime?
  scheduledFor DateTime? @db.Date
  order       Int       @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, parentId])
  @@index([userId, scheduledFor])
}

model NavHabit {
  id     String @id @default(cuid())
  userId String

  name        String
  emoji       String  @default("*")
  targetPerWk Int     @default(7)
  cue         String? // when/where it hangs off an existing routine
  active      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())

  logs NavHabitLog[]

  @@index([userId, active])
}

model NavHabitLog {
  id      String   @id @default(cuid())
  userId  String
  habitId String
  date    DateTime @db.Date
  done    Boolean  @default(true)

  habit NavHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model NavMeal {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  // breakfast | lunch | dinner | snack
  slot        String
  title       String
  ingredients Json? // string[]
  prepMins    Int     @default(10)
  protein     Int? // rough grams, for pattern spotting
  notes       String? @db.Text
  eaten       Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model NavGroceryItem {
  id     String @id @default(cuid())
  userId String

  name     String
  qty      String?
  category String  @default("other") // produce | protein | dairy | pantry | frozen | other
  checked  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, checked])
}

model NavWorkout {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  title       String
  kind        String  @default("movement") // strength | cardio | mobility | walk | movement
  durationMins Int    @default(10)
  intensity   String  @default("easy") // easy | moderate | hard
  steps       Json? // string[] — the actual exercises
  completed   Boolean @default(false)
  notes       String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model NavFocusSession {
  id     String @id @default(cuid())
  userId String

  label       String
  taskId      String?
  plannedMins Int      @default(50)
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  actualMins  Int?
  distractions Int     @default(0)
  outcome     String?  @db.Text
  completed   Boolean  @default(false)

  @@index([userId, startedAt])
}

model NavCheckin {
  id     String   @id @default(cuid())
  userId String
  at     DateTime @default(now())

  // energy | hunger | overstim | mood | focus
  kind  String
  value Int // 1-5
  note  String? @db.Text

  @@index([userId, at])
  @@index([userId, kind])
}

model NavChatMessage {
  id     String @id @default(cuid())
  userId String

  // user | assistant
  role    String
  content String  @db.Text
  actions Json? // what the assistant actually did, for transparency

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
