model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String   @db.Text
  category   String   @default("hospitality")
  tags       String   @default("")
  metaTitle  String
  metaDesc   String
  coverImage String?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // SEO autopilot fields
  keyword      String? // the target query this article was written for
  faq          String?   @db.Text // JSON array of {q,a} — renders as FAQ + FAQPage schema
  wordCount    Int?
  refreshedAt  DateTime? // last time the autopilot rewrote/expanded it
  refreshCount Int       @default(0)

  @@index([slug])
  @@index([published, createdAt])
}

// ---------------------------------------------------------------------------
// SEO autopilot
//
// The paid tools (Soro, Outrank et al) are three loops bolted together:
// harvest queries people actually type, publish one article per query, then
// watch Search Console and go back over whatever nearly ranks. These three
// models are the state those loops need. Everything here is free to run:
// Google Suggest needs no key, Search Console's API is free, IndexNow is free.
// ---------------------------------------------------------------------------

model SeoKeyword {
  id      String @id @default(cuid())
  keyword String @unique
  cluster String @default("general") // topical map bucket, e.g. "rota software"
  intent  String @default("informational") // informational | commercial | transactional | local
  region  String @default("general") // general | us | uk | ie
  source  String @default("seed") // seed | suggest | paa | gsc | ai

  // Live Search Console numbers, refreshed by the keyword cron. Real data, not
  // a guessed "volume" — impressions ARE the volume we can actually reach.
  impressions Int    @default(0)
  clicks      Int    @default(0)
  position    Float?

  priority Int     @default(0) // computed score, higher wins the next article
  status   String  @default("new") // new | queued | written | skipped
  postId   String? // BlogPost.id once written
  note     String? // why it was skipped / how it was scored

  writtenAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, priority])
  @@index([cluster])
}

// AiPrompt — a buying question we want an AI assistant to name Rotahr in.
//
// This is the "generative engine optimisation" half of SEO: an owner asking
// ChatGPT "best rota app for a small pub" is a warmer lead than a Google
// searcher, and almost nobody is measuring whether they get named.
model AiPrompt {
  id      String  @id @default(cuid())
  prompt  String  @unique
  cluster String  @default("general")
  intent  String  @default("commercial")
  region  String  @default("general")
  active  Boolean @default(true)

  createdAt DateTime       @default(now())
  checks    AiVisibility[]

  @@index([active])
}

// AiVisibility — one answer from one model at one point in time.
//
// The full answer is stored on purpose: a score with no evidence is
// unfalsifiable, and reading the actual wording is how you learn what to
// write next.
model AiVisibility {
  id       String   @id @default(cuid())
  promptId String
  prompt   AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  model  String // gpt-4o-mini | sonar | ...
  answer String @db.Text

  mentioned   Boolean @default(false)
  rank        Int? // 1-based place in the answer where Rotahr appears; null when absent
  cited       Boolean @default(false) // did it name/link rotahr.com
  competitors String  @default("") // competitor names found, comma separated

  createdAt DateTime @default(now())

  @@index([promptId, createdAt])
  @@index([createdAt])
}

model SeoMetric {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  page        String // full URL from Search Console
  query       String   @default("") // "" = page-level row
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([date, page, query])
  @@index([page, date])
  @@index([date])
}

model SeoRun {
  id        String   @id @default(cuid())
  task      String // keywords | publish | refresh | index | metrics
  ok        Boolean  @default(true)
  detail    String   @db.Text
  createdAt DateTime @default(now())

  @@index([task, createdAt])
}

model WastageRecord {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  itemName   String // free-text fallback if no stockItemId
  quantity   Float
  unit       String   @default("unit")
  unitCost   Float? // cost per unit at time of recording
  totalCost  Float? // quantity × unitCost
  reason     String   @default("spoilage") // spoilage | over-prep | spill | expiry | other
  notes      String?
  recordedBy String // userId
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([businessId, date])
  @@index([businessId, stockItemId])
}

model HACCPRecord {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  checkType   String
  checkedAt   DateTime @default(now())
  checkedById String
  checkedBy   User     @relation(fields: [checkedById], references: [id])
  data        Json
  status      String   @default("pass")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([businessId, checkType])
  @@index([businessId, checkedAt])
}

// Custom checklist task templates per business per check type
model HACCPChecklistTemplate {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  checkType   String
  items       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("HaccpTemplateUpdater", fields: [updatedById], references: [id])

  @@unique([businessId, checkType])
